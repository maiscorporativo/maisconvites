# Copie este arquivo para .env e preencha os valores
# (nunca coloque senhas/chaves reais neste arquivo de exemplo)

# Porta do servidor
PORT=3000

# URL pública do sistema (usada nos links dos convites e QR codes)
BASE_URL=http://localhost:3000

# Segredo da sessão (troque por uma string aleatória longa)
SESSION_SECRET=troque-este-segredo-por-uma-string-aleatoria

# Produção atrás de proxy reverso com HTTPS (nginx / painel da hospedagem):
# defina TRUST_PROXY=1 para cookies de sessão seguros funcionarem atrás do proxy.
TRUST_PROXY=0

# Pasta onde ficam o banco SQLite e os uploads (banner/timbrado).
# Em deploy via GitHub (cada redeploy substitui os arquivos do app), aponte para um
# caminho persistente FORA da pasta do app para não perder os dados a cada deploy.
# Vazio = pasta ./data dentro do projeto (padrão para uso local).
DATA_DIR=

# ── E-mail (SMTP) ─────────────────────────────────────────────
# Se não configurado, o sistema funciona em "modo simulação":
# gera a mensagem e mostra na tela para envio manual.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Jantar FECOFAR <convites@exemplo.com.br>"

# ── WhatsApp via Evolution API (opcional) ─────────────────────
# Envio automático pela sua instância da Evolution API.
# Tem prioridade sobre a Cloud API se ambas estiverem configuradas.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# ── WhatsApp Cloud API oficial da Meta (opcional) ─────────────
# Se nenhuma API de WhatsApp for configurada, o sistema gera links
# wa.me com a mensagem pronta (envio com um clique pelo WhatsApp Web).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
